# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==============================================
# DATABASE (PostgreSQL / Neon)
# ==============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task_management?schema=public"

# ==============================================
# REDIS & BULLMQ (Upstash / Local Redis)
# ==============================================
REDIS_URL="redis://localhost:6379"

# ==============================================
# AUTHENTICATION & JWT
# ==============================================
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# ==============================================
# CLOUDINARY (Media & Attachments Storage)
# ==============================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ==============================================
# EMAIL (SMTP / Gmail / Resend)
# ==============================================
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-app-specific-password"
MAIL_FROM="Pyramid <your-email@gmail.com>"

# ==============================================
# FIREBASE CLOUD MESSAGING (Push Notifications)
# Place service-account.json in ./firebase directory
# OR pass as base64/JSON string in FIREBASE_SERVICE_ACCOUNT
# ==============================================
# FIREBASE_SERVICE_ACCOUNT=""
